{  
  "compilerOptions": {  
    "target": "ES2022",  
    "jsx": "react-jsx",  
    "lib": ["ES2022", "DOM"],  
    "module": "ESNext",  
    "moduleResolution": "Bundler",  
    "types": ["node"],  
    "strict": true,  
    "noEmit": true,  
    "esModuleInterop": true,  
    "isolatedModules": true,  
    "skipLibCheck": true,  
    "resolveJsonModule": true,  
    "forceConsistentCasingInFileNames": true,  
    "paths": {  
      "@/*": ["./*"]  
    }  
  },  
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],  
  "exclude": ["node_modules", "dist", "templates", "src/tests"]
}