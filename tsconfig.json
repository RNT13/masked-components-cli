{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "dist", "templates"],
  "paths": {  
      "@/utils/masked-utils": ["./templates/masked-utils/index.ts"],  
      "@/utils/masked-utils/*": ["./templates/masked-utils/*"],  
      "@/styles/MaskedThemes/*": ["./templates/masked-themes/MaskedThemes/*"],  
      "@/styles/MaskedAnimations/*": ["./templates/masked-animations/MaskedAnimations/*"],  
      "@/components/*": ["./templates/masked-config/*"],
      "@/*": ["./*"]  
    } 
}
